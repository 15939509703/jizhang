<view class="page">
  <view class="row-between">
    <view class="page-title">账本管理</view>
    <button class="add-button" bindtap="toggleCreate">{{showCreate ? '取消' : '+ 新建'}}</button>
  </view>

  <view wx:if="{{showCreate}}" class="panel create-panel">
    <view class="section-heading">新建账本</view>
    <view class="field"><text class="field-label">名称</text><input class="field-value" value="{{newBook.name}}" data-field="name" placeholder="例如：家庭账本" bindinput="handleInput" /></view>
    <view class="field"><text class="field-label">说明</text><input class="field-value" value="{{newBook.description}}" data-field="description" placeholder="选填" bindinput="handleInput" /></view>
    <button class="btn btn-primary btn-block create-button" loading="{{creating}}" disabled="{{creating}}" bindtap="handleCreate">创建并切换</button>
  </view>

  <view wx:if="{{!loading && !books.length}}" class="empty-state">暂无可用账本</view>
  <block wx:for="{{books}}" wx:key="id">
    <view class="panel book-item" data-id="{{item.id}}" bindtap="handleSwitch">
      <view class="row-between">
        <view class="book-main"><view class="item-title">{{item.name}}</view><view class="item-desc">{{item.description || '暂无说明'}} · {{item.role}}</view></view>
        <view class="book-state {{item.current ? 'current' : ''}}">{{item.current ? '当前' : '切换'}}</view>
      </view>
    </view>
  </block>
  <app-nav current="settings" items="{{navItems}}" />
</view>
