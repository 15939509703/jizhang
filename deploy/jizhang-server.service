[Unit]
Description=Jizhang backend service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=jizhang
Group=jizhang
WorkingDirectory=/opt/jizhang-server
EnvironmentFile=/etc/jizhang/jizhang-server.env
ExecStartPre=/usr/bin/mkdir -p /var/lib/jizhang/tmp /var/lib/jizhang/uploads
ExecStart=/usr/bin/java -Xms128m -Xmx384m -XX:+ExitOnOutOfMemoryError -Djava.io.tmpdir=/var/lib/jizhang/tmp -jar /opt/jizhang-server/jizhang-server.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
