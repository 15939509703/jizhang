<view class="page">
  <view class="row-between">
    <view>
      <view class="page-subtitle">{{todayLabel}}</view>
      <view class="page-title">晚上好，{{userName}}</view>
    </view>
    <view class="tag">{{monthLabel}}</view>
  </view>
  <view class="panel" style="margin-top: 24rpx;">
    <view class="row-between {{summaryLoading ? 'summary-loading' : ''}}">
      <view>
        <view class="muted">收入</view>
        <view class="money success">{{summary.incomeText}}</view>
      </view>
      <view>
        <view class="muted">支出</view>
        <view class="money danger">{{summary.expenseText}}</view>
      </view>
      <view>
        <view class="muted">结余</view>
        <view class="money primary">{{summary.balanceText}}</view>
      </view>
    </view>
  </view>
  <app-nav current="home" items="{{navItems}}" />
</view>
