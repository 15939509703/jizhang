<view class="page">
  <view class="page-title">预算管理</view>
  <block wx:for="{{budgets}}" wx:key="id">
    <view class="panel" style="margin-top: 24rpx;">
      <view class="row-between"><view><view class="item-title">{{item.name}}</view><view class="item-desc">{{item.usedText}} / {{item.limitText}}</view></view><view class="tag">{{item.percent}}%</view></view>
      <view class="progress" style="margin-top: 16rpx;"><view class="progress-bar {{item.statusClass}}" style="width: {{item.percent}}%;"></view></view>
    </view>
  </block>
  <app-nav current="settings" items="{{navItems}}" />
</view>
