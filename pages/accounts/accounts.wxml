<view class="page">
  <view class="page-title">账户管理</view>
  <view class="panel" style="margin-top: 24rpx;"><view class="money large primary">{{totalBalanceText}}</view></view>
  <block wx:for="{{accounts}}" wx:key="id">
    <view class="panel"><view class="row-between"><view><view class="item-title">{{item.name}}</view><view class="item-desc">{{item.typeText}} · {{item.note}}</view></view><view class="money {{item.balanceClass}}">{{item.balanceText}}</view></view></view>
  </block>
  <app-nav current="settings" items="{{navItems}}" />
</view>
