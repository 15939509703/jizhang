.app-nav {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  display: flex;
  padding: 10rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid #e5e7eb;
  box-shadow: 0 10rpx 32rpx rgba(15, 23, 42, 0.08);
  z-index: 10;
}

.app-nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0;
  border-radius: 18rpx;
  background: transparent;
}

.app-nav-item.is-active {
  background: #eaf1ff;
}

.app-nav-icon {
  font-size: 30rpx;
  line-height: 1;
  color: #6b7280;
}

.app-nav-item.is-active .app-nav-icon,
.app-nav-item.is-active .app-nav-label {
  color: #2e6de9;
}

.app-nav-label {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #6b7280;
}
