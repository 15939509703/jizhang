<view class="page">
  <view class="panel" style="margin-top: 72rpx;">
    <view class="page-title" style="text-align:center;">记账小程序</view>
    <view class="page-subtitle" style="text-align:center;">微信授权后即可创建个人账本</view>
    <view style="margin-top: 24rpx;">
      <button class="btn btn-primary btn-block" loading="{{loading}}" bindtap="handleWechatLogin">微信一键登录</button>
    </view>
    <view style="margin-top: 16rpx;">
      <button class="btn btn-ghost btn-block" loading="{{demoLoading}}" bindtap="handleDemoLogin">游客体验</button>
    </view>
    <view class="item-desc" style="margin-top: 20rpx; text-align:center;">
      <text wx:if="{{hasLocalUser}}">已识别本地账号：{{userName}}</text>
      <text wx:else>未登录，点击上方按钮继续。</text>
    </view>
  </view>
</view>
