<view class="page">
  <view class="row-between">
    <view class="page-title">账户管理</view>
    <button class="add-button" bindtap="toggleCreate">{{showCreate ? '取消' : '+ 新建'}}</button>
  </view>
  <view class="panel balance-panel"><view class="muted">计入资产的账户余额</view><view class="money large primary">{{totalBalanceText}}</view></view>

  <view wx:if="{{showCreate}}" class="panel create-panel">
    <view class="section-heading">新建账户</view>
    <view class="field"><text class="field-label">名称</text><input class="field-value" value="{{newAccount.name}}" data-field="name" placeholder="例如：微信零钱" bindinput="handleInput" /></view>
    <picker range="{{typeOptions}}" range-key="label" value="{{newAccount.typeIndex}}" bindchange="handleTypeChange">
      <view class="field"><text class="field-label">类型</text><text class="field-value">{{typeOptions[newAccount.typeIndex].label}}</text></view>
    </picker>
    <view class="field"><text class="field-label">初始余额</text><input class="field-value" type="digit" value="{{newAccount.initialBalance}}" data-field="initialBalance" bindinput="handleInput" /></view>
    <button class="btn btn-primary btn-block create-button" loading="{{creating}}" disabled="{{creating}}" bindtap="handleCreate">创建账户</button>
  </view>

  <view wx:if="{{!loading && !accounts.length}}" class="empty-state">当前账本暂无账户</view>
  <block wx:for="{{accounts}}" wx:key="id">
    <view class="panel account-item"><view class="row-between"><view><view class="item-title">{{item.name}}</view><view class="item-desc">{{item.typeText}} · {{item.accountNature === 'ASSET' ? '资产' : '负债'}}</view></view><view class="money {{item.balanceClass}}">{{item.balanceText}}</view></view></view>
  </block>
  <app-nav current="settings" items="{{navItems}}" />
</view>
