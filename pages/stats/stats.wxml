<view class="page">
  <view class="page-title">统计分析</view>
  <view class="panel" style="margin-top: 24rpx;">
    <view class="row-between">
      <view><view class="muted">收入</view><view class="money success">{{summary.incomeText}}</view></view>
      <view><view class="muted">支出</view><view class="money danger">{{summary.expenseText}}</view></view>
      <view><view class="muted">结余</view><view class="money primary">{{summary.balanceText}}</view></view>
    </view>
  </view>
  <app-nav current="stats" items="{{navItems}}" />
</view>
