<view class="page">
  <view class="page-title">账本管理</view>
  <block wx:for="{{books}}" wx:key="id">
    <view class="panel" style="margin-top: 24rpx;"><view class="row-between"><view><view class="item-title">{{item.name}}</view><view class="item-desc">{{item.desc}}</view></view><view class="tag"><text wx:if="{{item.current}}">当前</text><text wx:else>{{item.memberCount}}人</text></view></view></view>
  </block>
  <app-nav current="settings" items="{{navItems}}" />
</view>
