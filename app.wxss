page {
  background: #f5f7fb;
  color: #1f2937;
  font-size: 28rpx;
}

view,
text,
input,
button,
textarea,
picker {
  box-sizing: border-box;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 120rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 500;
  line-height: 1.2;
}

.page-subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.panel {
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: 20rpx;
  padding: 24rpx;
}

.panel + .panel {
  margin-top: 20rpx;
}

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.muted {
  color: #6b7280;
}

.primary {
  color: #2e6de9;
}

.success {
  color: #1f9d63;
}

.danger {
  color: #d9534f;
}

.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  color: #475569;
  font-size: 22rpx;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 80rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.btn-primary {
  background: #2e6de9;
  color: #ffffff;
}

.btn-ghost {
  background: #ffffff;
  color: #1f2937;
  border: 1rpx solid #dbe2ea;
}

.btn-block {
  width: 100%;
}

.field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  padding: 0 20rpx;
  border: 1rpx solid #dbe2ea;
  border-radius: 18rpx;
  background: #ffffff;
}

.field + .field {
  margin-top: 16rpx;
}

.field-label {
  color: #6b7280;
  font-size: 24rpx;
}

.field-value {
  color: #111827;
  font-size: 28rpx;
  text-align: right;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 4rpx 16rpx;
}

.section-title text:first-child {
  font-size: 30rpx;
  font-weight: 500;
}

.progress {
  width: 100%;
  height: 16rpx;
  border-radius: 999rpx;
  background: #e8eef6;
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  border-radius: inherit;
  background: #2e6de9;
}

.progress-bar.success {
  background: #1f9d63;
}

.progress-bar.warn {
  background: #d39b2d;
}

.progress-bar.danger {
  background: #d9534f;
}

.list {
  display: flex;
  flex-direction: column;
}

.list-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eef2f7;
}

.list-item:last-child {
  border-bottom: 0;
}

.item-title {
  font-size: 28rpx;
  font-weight: 500;
}

.item-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.money {
  font-size: 30rpx;
  font-weight: 500;
}

.money.large {
  font-size: 42rpx;
}
