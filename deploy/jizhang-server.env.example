SPRING_PROFILES_ACTIVE=prod
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8081

DB_URL=jdbc:mysql://127.0.0.1:3306/jizhang_db?createDatabaseIfNotExist=false&useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=jizhang_app
DB_PASSWORD=replace-with-a-strong-password
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=5000
SPRING_LIQUIBASE_ENABLED=true

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-the-server-redis-password
REDIS_TIMEOUT=2s

WX_APP_ID=replace-with-wechat-app-id
WX_APP_SECRET=replace-with-wechat-app-secret
JWT_SECRET_BASE64=replace-with-openssl-rand-base64-32-output

UPLOAD_DIR=/var/lib/jizhang/uploads
HTTP_LOG_INCLUDE_BODY=false
HTTP_LOG_MAX_PAYLOAD_LENGTH=4096
SWAGGER_ENABLED=false

FEATURE_RECURRING_TRANSACTIONS=true
FEATURE_TRANSACTION_CALENDAR=true
FEATURE_BUDGET_FORECAST=true
FEATURE_ASSET_DASHBOARD=true
RECURRING_SCAN_INTERVAL_MS=300000
